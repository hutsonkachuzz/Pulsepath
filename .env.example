# ==============================================================================
# PULSEPATH - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Database & Authentication (Client-side / Netlify Edge)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Serverless / Netlify Functions)
# ------------------------------------------------------------------------------
# Option A: Path to serviceAccountKey.json file (for local development)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option B: Raw JSON string of serviceAccountKey.json (Recommended for Netlify Dashboard Environment Variables)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ------------------------------------------------------------------------------
# Backend Settings (FastAPI / Optional Server)
# ------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_64_character_hex_key_here
DATABASE_URL=sqlite:///./pulsepath.db
ACCESS_TOKEN_EXPIRE_MINUTES=20160
BACKEND_CORS_ORIGINS=http://localhost:3000,https://pulsepath.netlify.app

# ------------------------------------------------------------------------------
# Frontend Settings (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_URL=
VITE_WS_URL=
